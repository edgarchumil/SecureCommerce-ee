APP_ENV=development
APP_NAME=SecureCommerce Advisor
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=change-this-development-secret-with-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://securecommerce:securecommerce_dev@postgres:5432/securecommerce
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false
POSTGRES_DB=securecommerce
POSTGRES_USER=securecommerce
POSTGRES_PASSWORD=securecommerce_dev
VITE_API_URL=/api/v1
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_ENABLED=false
AI_MAX_TOKENS=1000
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_BUDGET_LIMIT=25
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
REPORT_STORAGE_PATH=storage/reports
BACKUP_ENCRYPTION_KEY=change-this-backup-key-with-at-least-32-characters
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=35
DEMO_PASSWORD=change-this-demo-password
